<script>
   new Vue({
        el:"#newfooter",
        data:{
            open:[],
        },
        methods: {
            gitopen(){
                var that = this;
                var url = "/webApi/cms/commonParam/getParamConfig";
                ms.http.get(url,{}).then(function (res){
                    console.log('res',res);
                    if(res.data){
                        that.open = res.data
                    }
                })
            },
            HideFunc(id){
                if(this.open.includes(id)){//包含
                    return false
                }else{
                    return true
                }
            }
        },
        
    created:function (){
      this.gitopen()
    }
    })
</script></div>

<script>
  var selling = new Vue({
    el:"#selling",
    data:{
      netWorthOneClickId : 'all',//产品类型
      netWorthTwoClickId : 'all',
      netWorthLimitClickId : '全部',//产品期限
      netWorthRiskClickId : '全部',//风险等级
      netWorthCurrencyClickId: '全部',//币种
      chanpintouzixingzhi:'不限',//产品投资性质
      chanpinzhuangtai:'全部',//产品状态
      xianJinOneClickId : 'all',
      xianJinTwoClickId : 'all',
      xianJinLimitClickId : '全部',
      xianJinRiskClickId : '全部',
      xianJinCurrencyClickId: '全部',
      limitTag : ['全部','3个月及以内','3-6个月（含6个月）','6-12个月（含12个月）','一年以上'],//产品期限
      riskTag : ['全部','R1低风险','R2中低风险','R3中风险','R4中高风险','R5高风险'],//风险等级
      currencyTag : ['全部','人民币元','美元','英镑','港币','加拿大元','澳元','欧元','日元'],//币种
      cptzxz:['不限','固定收益类','权益类','商品及金融衍生品类','混合类'],//产品投资性质
      cpzt:['全部','在售产品','存续产品',],//产品状态
      search : "",
      netWorthSearch : "",
      xianJinSearch : "",
      datalist:[],//列表数据
      pageNo:1,
      total:0,
      tbodyActive:-1
    },
    methods:{
      tbodyActiveFunc:function(idx){
        console.log('idx',idx);
        this.tbodyActive = idx
      },
      tbodyActiveFunc1:function(){
        this.tbodyActive = -1
      },
      oneHandleTagClick : function (id,tag) {
          this.netWorthOneClickId = id;
          this.netWorthTwoClickId = 'all';
        
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      },
      limitHandleTagClick : function (val,tag) {
          this.netWorthLimitClickId = val;
        
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      },
      riskHandleTagClick : function (val,tag) {
          this.netWorthRiskClickId = val;
        
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      },
      currencyHandleTagClick: function(val,tag){
          this.netWorthCurrencyClickId = val;
        
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      },
      cptzxzClick: function(val,tag){
          this.chanpintouzixingzhi = val;
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      },
      cpztClick: function(val,tag){
          this.chanpinzhuangtai = val;
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      },
      reset: function(){
      this.netWorthOneClickId='all'//产品类型
      this.netWorthLimitClickId='全部'//产品期限
      this.netWorthRiskClickId='全部'//风险等级
      this.netWorthCurrencyClickId='全部'//币种
      this.chanpintouzixingzhi='不限'//产品投资性质
      this.chanpinzhuangtai='全部'//产品状态
      this.netWorthSearch = ''//搜索框
          this.pageNo = 1//每次切换从第一页开始
      this.getList();
      },
      netWorthSearchClick : function(){
          this.pageNo = 1//每次切换从第一页开始
        this.getList();
      }, 
      handleSizeChange:function(){

      },
      handleCurrentChange:function(val){
        console.log('val',val);
        console.log('val',this.total);
        this.pageNo = val
        this.getList()
      },
      getList: function(){
        console.log('/html/1/');
        //产品分类处理
        let path = $('.investorRange').data('name')
        let is183 = path.includes('183')
        let is222 = path.includes('222')
        let fenlei = ''
        if(is183){
          fenlei = '个人'
        }else{
          if(is222){
          fenlei = '机构'
          }
        }
        console.log('this.chanpinzhuangtai',this.chanpinzhuangtai);
        //产品状态处理
        let newcpzt=[]
        switch (this.chanpinzhuangtai) {
          case '全部':
            newcpzt = []
            break;
          case '在售产品':
            newcpzt = [3,4]
            break;
          case '存续产品':
            newcpzt = [5]
            break;
        
          default:
            break;
        }
        console.log('666',$('.investorRange').data());
        console.log('is183',is183);
        console.log('isss6',is222);
        var that = this;
                var url = "/webApi/cms/product/queryStaticProducts";
                var data = {
                  style:that.netWorthOneClickId == 'all'?'':that.netWorthOneClickId,//产品形态
                  timeLimit:that.netWorthLimitClickId == '全部'?'':that.netWorthLimitClickId,//产品期限
                  riskLevel:that.netWorthRiskClickId=='全部'?'':that.netWorthRiskClickId,//风险等级
                  currency:that.netWorthCurrencyClickId=='全部'?'':that.netWorthCurrencyClickId,//币种
                  productTypeName:that.chanpintouzixingzhi=='不限'?'':that.chanpintouzixingzhi,//产品投资性质
                  productClass:newcpzt,//产品状态
                  investorRange:fenlei,//产品分类
                  productKeyword:that.netWorthSearch,//产品名称
                  pageNo:that.pageNo,
                  pageSize:10,
                }
                var t = JSON.stringify(data)
                console.log('res',t);

                ms.http.post(url,t,{
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-TOKEN' : 'csrfToken'
                            }
                }).then(function (res){
                    console.log('res',res);
                    that.datalist = res.data.rows
                    that.total = res.data.total
                    console.log('that.total',that.total);
                })
      },
    },
    mounted : function () {
      this.getList()
    },
  })

</script>
</body>
