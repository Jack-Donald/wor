.c999{ color:#999}
.c666{ color:#666}
.f12{ font-size:12px;}
.f14{ font-size:14px;}
.f16{ font-size:16px;}
.f18{ font-size:18px;}
.f20{ font-size:20px;}
.f28{ font-size:28px;}
