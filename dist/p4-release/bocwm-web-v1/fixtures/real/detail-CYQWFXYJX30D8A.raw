            },
            getProGonGaoList:function (){
                var that = this;
                var url = "/webApi/cms/productDynamicPage/getProGonGaoList";
                var data = {
                    id:'9274',
                    type:'1'
                }
                ms.http.get(url,data).then(function (res){
                    if(res.result){
                        if(res.data==""){
                            that.proGonGaoList = [];
                        }else{
                            that.proGonGaoList = res.data;
                        }
                    }
                })
            },
            getPerformance: function (){
                var that = this;
                var url = "/webApi/cms/productPerformance/getPerformance";
                var data = {
                    productCode:'CYQWFXYJX30D8A'
                }
                ms.http.get(url,data).then(function (res){
                    if(res.result){
                        that.performanceForm = res.data;
                    }
                })
            },
            
        guowangyejiisok:function(){
            let day = '245'
            let typeName = '最短持有期'
            // if(product_class.indexOf('5') != -1 && typeName == '封闭'){//存续封闭式产品仅展示业绩比较基准
            if(typeName == '封闭'){//封闭式产品仅展示业绩比较基准没有过往业绩这个东西20241024下午开会说的
                this.isXinPin = true//顶部业绩比较基准展示
                this.opengwyjflag = true//tab栏过往业绩
                // this.tabs = [//开放过往业绩tab页
                //     {
                //         name:'产品说明书',
                //         id:0
                //     },{
                //         name:'产品净值',
                //         id:1
                //     },{
                //         name:'产品公告',
                //         id:2
                //     },{
                //         name:'产品运作报告',
                //         id:3
                //     },
                // ]

            }else{
                
                if (typeName == '现金管理') {
                        if (day >= 7) {//现金管理的七日年化超过7天展示过往业绩
                            // this.opengwyj()//展示过往业绩
                            this.opengwyjflag = true//tab栏过往业绩
                        }else{
                            this.opengwyjflag = false//tab栏过往业绩
                        }
                } else {//非现金管理
                        if (day >= 30) {//成立满一个月仅展示历史业绩，不展示业绩比较基准
                            // this.opengwyj()//展示过往业绩
                            this.opengwyjflag = true//tab栏过往业绩
                        } else {//新发及成立不满一个月非现类产品，不展示历史业绩，只展示业绩比较基准及其说明文字
                            console.log('不满足');
                            this.isXinPin = true//顶部业绩比较基准展示
                            this.opengwyjflag = false//tab栏过往业绩
                            // this.tabs = [//开放过往业绩tab页
                            //     {
                            //         name: '产品说明书',
                            //         id: 0
                            //     }, {
                            //         name: '产品净值',
                            //         id: 1
                            //     }, {
                            //         name: '产品公告',
                            //         id: 2
                            //     }, {
                            //         name: '产品运作报告',
                            //         id: 3
                            //     },
                            // ]
                        }
                }
            }
        },
        
        opengwyj: function () {
                            console.log('满足', this.guowangyejiList.length);
                if (this.guowangyejiList.length > 0) {//过往业绩有数据展示过往业绩否则不展示过往业绩
                    this.tabs = [
                        {
                            name: '产品说明书',
                            id: 0
                        }, {
                            name: '产品净值',
                            id: 1
                        }, {
                            name: '产品公告',
                            id: 2
                        }, {
                            name: '产品运作报告',
                            id: 3
                        },
                    ]
                } else {
                    this.tabs = [
                        {
                            name: '产品说明书',
                            id: 0
                        }, {
                            name: '产品净值',
                            id: 1
                        }, {
                            name: '产品公告',
                            id: 2
                        }, {
                            name: '产品运作报告',
                            id: 3
                        }
                    ]
                }
            }
        },
        filters:{
            baiFenBiFilter: function(value){
                if(value != null && value !== ""){
                    var _num = parseFloat(value+"").toFixed(3);
                    return  _num.substring(0,_num.length-1)+ "%";
                }else{
                    return "-";
                }
            }
        },
        created:function (){
            let clr = '2026-02-27'
            console.log('clr'+clr)
            this.fmtDate1 = this.fmtDatefunc(clr)//风险提示的成立日
            console.log('this.fmtDate'+this.fmtDate)
            console.log('this.fmtDate1'+this.fmtDate1)
            this.getNetWorthData();//折线图(拿右侧净值数据)111
            this.getNetWorthDataNew();//折线图（拿左侧折线图数据）
            this.getOpenDate();//下一开放日
            // this.getPerformance();//业绩信息
            this.getProductInstructionsList();//产品说明书
            this.getProductProYunZuoList();//产品运作报告
            this.getProGonGaoList();//产品公告
            this.getguowangyeji();//过往业绩
            let product_class = '4,5'
            let productName = '中银理财-稳富信用精选30天持有期8号'
            if(productName.indexOf('目标盈') != -1){
                this.isproductName = true
            }else{
                this.isproductName = false
            }
            console.log('this.isproductName',this.isproductName)
            console.log('productName',productName,'是否有目标盈）',productName.indexOf('目标盈') != -1,);
             
        }
    })
</script>
