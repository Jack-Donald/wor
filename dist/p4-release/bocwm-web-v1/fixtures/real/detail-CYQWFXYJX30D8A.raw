.text-wrapper{
    display: inline-block;
    width: 500px;
    word-break: break-all;
    overflow-wrap: break-word;
    white-space: normal;
}
.text-limit {
    /* width:300px; */
  display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical;
  overflow: hidden; text-overflow: ellipsis; line-height: 1.6;
}
.detail-btn { color: #a32727; cursor: pointer; font-size: 14px; margin-top: 4px; }
.text-full { 
    width:300px;margin-top: 4px; padding: 8px; background: #f5f7fa; border-radius: 4px; white-space: pre-wrap; }
    .table-wrapper {
    max-height: 720px;
    overflow-y: auto;      /* 超出时自动显示滚动条 */
    /* border: 1px solid #e4e7ed; */
    border-radius: 4px;
    }

    /* 2. 表格基础样式 */
    .fixed-header-table {
    width: 100%;
    border-collapse: collapse; /* 或使用 separate，见下方注意事项 */
    table-layout: fixed;       /* 防止内容撑破列宽 */
    }

    /* 3. 表头固定核心 */
    .fixed-header-table thead th {
    position: sticky;
    top: 0;                    /* 距离容器顶部 0px 时固定 */
    background-color: #f2f2f2;    /* 必须设置背景色，防止内容穿透 */
    z-index: 1;                /* 确保表头显示在内容层之上 */
    /* border-bottom: 2px solid #dcdfe6; */
    font-weight: 600;
        padding: 9px 15px;
    }
    .fixed-header-table tbody tr {
        border-bottom: 1px solid #f2f2f2;
    }
    .fixed-header-table tbody tr:hover {
    background-color: #fafafa;
    }
    </style>
</head>

