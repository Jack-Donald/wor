            fmtDatefunc(val){
                if(val){
                    const dates = new Date(val);
                    let y = dates.getFullYear();
                    let m = dates.getMonth() + 1;
                    let d = dates.getDate();
                    return y+'年'+m+'月'+d+'日'
                }
            },
            tabfunc:function(tab) {
                console.log(tab);
                this.activetab = tab.id
            },
            chaxunfunc(row){
                console.log(row)
                this.chaxunactive = row.id
                this.getNetWorthDataNew()
            },
            getNetWorthDataNew:function (){
                var that = this;
                var url = "/webApi/cms/productNetWorth/getNetWorthImageByCode";
                var data = {
                    productCode:'CYQWFXYJX30D8A',
                    dayCount:this.chaxunactive.toString()
                }
                if(this.chaxunactive == 4){
                delete data.dayCount
                }
                ms.http.get(url,data).then(function (res){
                    console.log('resresresresres',res);
                    if(res.result){
                        that.sevenDayAnnualization = res.sevenDayAnnualization//基本信息的七日年化收益率
                        //单位净值
                        that.danWeiJingZhiOption.xAxis.data = res.dateList;//日期
                        that.danWeiJingZhiOption.series.pop();
                        that.danWeiJingZhiOption.series.push({
                            data:res.shareNetWorthList,
                            type:'line'
                        });
                        //累计净值折线图
                        that.leiJiJingZhiOption.xAxis.data = res.dateList;//日期
                        that.leiJiJingZhiOption.series.pop();
                        that.leiJiJingZhiOption.series.push({
                            data:res.cumulativeNetWorthList,
                            type:'line'
                        });
                        
                        //七日年化走势图
                        that.qirinianhuaOption.xAxis.data = res.dateList;//日期
                        that.qirinianhuaOption.series.pop();
                        that.qirinianhuaOption.series.push({
                            data:res.sevenDayAnnualizationList,
                            type:'line'
                        });
                        //万份收益走势图
                        that.wanfenshouyiOption.xAxis.data = res.dateList;//日期
                        that.wanfenshouyiOption.series.pop();
                        that.wanfenshouyiOption.series.push({
                            data:res.eachTenThousandProfitList,
                            type:'line'
                        });
                    }
                    var danWeiJingZhiOptionChart = echarts.init(document.getElementById('danWeiJingZhiCharts'));
                    danWeiJingZhiOptionChart.setOption(that.danWeiJingZhiOption);
                    var leiJiJingZhiOptionChart = echarts.init(document.getElementById('leiJiJingZhiCharts'));
                    leiJiJingZhiOptionChart.setOption(that.leiJiJingZhiOption);
                    var qirinianhuaOptionChart = echarts.init(document.getElementById('qirinianhuaCharts'));
                    qirinianhuaOptionChart.setOption(that.qirinianhuaOption);
                    var wanfenshouyiOptionChart = echarts.init(document.getElementById('wanfenshouyiCharts'));
                    wanfenshouyiOptionChart.setOption(that.wanfenshouyiOption);
                })
            },
            getNetWorthData:function (){
                var that = this;
                var url = "/webApi/cms/productNetWorth/getNetWorthByCode";
                var data = {
                    productCode:'CYQWFXYJX30D8A',
                    pageNo:this.pageNo,
                    pageSize:10
                }
                ms.http.get(url,data).then(function (res){
                    if(res.result){
                        that.netWorthList = res.data;
                        that.total = res.total
                        that.netWorthList.sort((a,b)=>{
                            var x=a['releaseDate'];
                            var y=b['releaseDate'];
                            return ((Date.parse(x)>Date.parse(y))?-1:(Date.parse(x)<Date.parse(y)?1:0));
                        });
                        console.log('productType',res.productType);
                        console.log('现金管理',res.productType.indexOf("现金管理")!=-1);
                        if(res.productType.indexOf("现金管理")!=-1){
                            that.xianjinguanli = true;
                        }
                        console.log('that.xianjinguanli',);
                    }
                })
            },
            activebtn:function(val){
                if(val ==0){
                  if(this.currentPage ==1){
                      return
                  }  else{
                      this.getlist(0)
                  }
                }else{
                      this.getlist(1)
                }
            },
            getlist:function(val){
                if(val == 0){
                    this.currentPage = this.currentPage >1?this.currentPage-1:1
                }else{
                    this.currentPage = this.currentPage+1
                }
                if(((this.currentPage * 10) - this.total) >=10 ){
                    return this.currentPage = this.currentPage - 1
                }else{
                    this.pageNo = this.currentPage
                    this.getNetWorthData()
                }
            },
            getOpenDate:function (){
                var that = this;
                var url = "/webApi/cms/productOpenDate/getOpenDate";
                var data = {
                    productCode:'CYQWFXYJX30D8A'
                }
                ms.http.get(url,data).then(function (res){
                    if(res.result){
                        if(res.data==""){
                            that.openDate = "-";
                        }else{
                            that.openDate = res.data;
                        }
                    }
                })
            },
