    <style>
        .font_size{
            width: 100% !important;
        }
        .rowtop{
            margin: 40px 40px 60px 40px ;
            
        }
        .toprow{
            font-size: 18px;
            line-height: 50px;
            color: #666;
            font-weight: 500;
        }
        .toprow span{
            color: #000;
            margin-right: 12px;
        }
        .row-title{
            font-size: 24px;
            color: #000;
            font-weight: bold;
            line-height: 40px;
        }
        .row-ts{
            font-size: 18px;
            margin: 0 0 15px;
            color: #666;
        }
        .tabs-t{
            display: flex;
            margin: 0 25px;
        }
        .tabs-btn{
            height: 50px;
            font-size: 18px;
            /* font-weight: 600; */
            margin: 0 16px;
            color: #000;
        }
        .tabs-btn:hover{
            color: #b40129;
        }
        .tabbor{
            color: #b40129;
            border-bottom: 2px solid #b40129;;
        }
        .tabinfo{
            width: 100%;
            min-height: 500px;
            border-radius: 10px;
            border: 1px solid #dddddd;
        }
        .layui-tab-title{
            font-size: 16px;
            color:#000;
        }
        .layui-tab-title .layui-this{
            color: #b40129;
            font-weight: 600;
        }
