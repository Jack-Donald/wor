<script>
    new Vue({
        el:"#xinPinSuDi1",
        data:{
            urlPath : location.pathname,
            noticeModel : "Content",
            data: "",
            scope: "all",
            curCategory: "",
            open:[],
            active:0,
            activeout:0,
            activehref:0,
            ahref:'/',
            ahrefMax:'/max/'
        },
        methods: {
            init : function(){
            },
            search: function(){
                    if(this.data === '' || this.data == null){
                        return ;
                    }
                    var url = "/html/1/" + "/189/index.html?data=" + encodeURIComponent(this.data)+"&type="+this.scope;
                    location.href=url;
            },
            gitopen(){
                var that = this;
                var url = "/webApi/cms/commonParam/getParamConfig";
                ms.http.get(url,{}).then(function (res){
                    console.log('res',res);
                    if(res.data){
                        that.open = res.data
                    }
                })
            },
            mouseenterfunc(idx){
                this.active = idx
                this.activeout = idx
            },
            mouseleavefunc(idx){
                this.active = this.activehref
                this.activeout = 0
            },
            HideFunc(id){
                if(this.open.includes(id)){//包含
                    return false
                }else{
                    return true
                }
            }
        },
    mounted : function () {
        //点击头部导航栏栏位，跳转页面后红色提示框停留在该位置而非挪动首页
        let href = window.location.href
        if(href.includes('/186/')){
            this.active= this.activehref = 1
        }else if(href.includes('/151/')||href.includes('/3/')||href.includes('/4/')||href.includes('/5/')){
            this.active= this.activehref = 2
        }else if(href.includes('/198/')||href.includes('/netWorth/')){
            this.active= this.activehref = 3
        }else if(href.includes('/187/')){
            this.active= this.activehref = 4
        }else if(href.includes('/237/')){
            this.active= this.activehref = 5
        }else{//其他情况默认首页
            this.active = this.activehref = 0
        }
        
        const url = window.location.href
        if(url.indexOf('/html/') !==-1){//有/html/
            if(url.indexOf('/1/') !==-1){
                this.ahrefMax = url.replace('/1/','/2/')
            this.ahref = url
            }
            if(url.indexOf('/2/') !==-1){
                this.ahrefMax = url
                this.ahref =url.replace('/2/','/1/')
            }
        }else{
            this.ahrefMax = '/max/'
            this.ahref = '/'
        }

    },
    created:function (){
      this.gitopen()
    }
    })
</script>    <div class="bghui" id="productDetail">
