            gitopen(){
                var that = this;
                var url = "/webApi/cms/commonParam/getParamConfig";
                ms.http.get(url,{}).then(function (res){
                    console.log('res',res);
                    if(res.data){
                        that.open = res.data
                    }
                })
            },
            HideFunc(id){
                if(this.open.includes(id)){//包含
                    return false
                }else{
                    return true
                }
            }
