<script type="text/javascript">
function checkAll(){
	
	if(checkNull()){
		if(!checkmoney()){
			return false;
		}else{
			var aaa = $("#aaa").val();
			var bbb = "XFTLCY0199B";
			if(confirm("尊敬的客户，您好！为维护您的权益，请您确认该产品是否是您自主购买，如是，请点击“确定”按钮；如否，请您至我行营业网点完成购买，并点击“取消”按钮。")){
				window.location.href = "https://ebanks.cgbchina.com.cn/perbank/CGB0101.do?orderType=01&orderAmt=" + aaa + "&productId=" + bbb;
			}
		}
	}
	return false;
}

//判空验证
function checkNull(){
	var aaa    = $("#aaa").val();
	var lee = document.forms["apply_form"].lee;
	//alert(lee.checked);
    if(trim(aaa) == ""){
		alert('请输入购买金额');
		$("#aaa").focus();
		return false;
	}
    
    if(lee.checked == false){
    	
		alert('请确认已阅读风险提示');
		$("#bbb").focus();
		return false;
    }
	return true;

}

//去除无效字符
function trim(s) {
     return s.replace( /^\s*/, "" ).replace( /\s*$/, "" );
}

function checkmoney(){
	var salary        = $("#aaa").val();
	var bool = checkMoney(salary);
	return bool;	
}

function checkMoney(ssn){
    var re = /^[0-9]*[0-9]$/i;
    var pmaxAmt = 0.00==0.00?0:0.00;
   
    var psubUnit = 1==0.00?0:1; //单位
    var pAmt = 1.00==0.00?0:1.00;  //递增
    
    var mod=(ssn*100-psubUnit*100)/100;
    var pAmt2=pAmt*100/100;
    var psubUnit2=psubUnit*100/100;

    if (re.test(ssn) && ssn>0){
	    if(pmaxAmt>0 && ssn>pmaxAmt){
	    	alert("购买金额不能大于单笔最大购买金额");
	    	return false;
	    }else if(psubUnit>0 && ssn<psubUnit) {
	    	alert("购买金额必须不低于购买单位金额	");
	    	return false; 
	    }else if( (pAmt > 0) && (mod%pAmt2 != 0 )){
		    alert("购买金额必须为递增金额的整数倍	");
	    	return false;
	    }else if (mod%psubUnit2 != 0 && psubUnit2>0){
		    alert("购买金额应为购买单位的整数倍 	");
	    	return false;	    	
	    }
	 }else{
    	alert("非法金额，请重新输入");
    	return false;	 
	 }
     return true;
    }

</script>
