		<script>
		function gotoPage(pageNum){
			if (!/^[1-9]+\d*$/.exec(pageNum) || parseInt(pageNum,10)>parseInt(0)) {
				//console.log(parseInt(pageNum));
				 alert ('请输入有效页码!');//输入的页码无效!
				 document.getElementById("GotoPage").focus();
				 return false;
			 }else{
				document.getElementById("curPage").value = pageNum;
				pdForm.proName.value = Simplized(pdForm.proName.value);
				pdForm.proCode.value = Simplized(pdForm.proCode.value);
				pdForm.submit();
			}
		}
		function PROFORMsubmit(){
			PROForm.proName.value = Simplized(PROForm.proName.value);
			PROForm.proCode.value = Simplized(PROForm.proCode.value);
			PROForm.submit();
		}
		</script>
