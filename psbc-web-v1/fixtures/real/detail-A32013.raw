        <script>
            $(function () {
                        if ($(".fhfs").html().trim() == '0') {
                            $(".fhfs").html('不区分')
                        } else if ($(".fhfs").html().trim() == '1') {
                            $(".fhfs").html('现金分红')
                        } else if ($(".fhfs").html().trim() == '2') {
                            $(".fhfs").html('红利再投')
                        }

                        if ($(".sfvip").html().trim() == '0') {
                            $(".sfvip").html('否')
                        } else if ($(".sfvip").html().trim() == '3') {
                            $(".sfvip").html('是')
                        }

                        if ($(".sfjfdhcp").html().trim() == '0') {
                            $(".sfjfdhcp").html('否')
                        } else if ($(".sfjfdhcp").html().trim() == '1') {
                            $(".sfjfdhcp").html('是')
                        }

                        if ($(".vipdj").html() == '1') {
                            $(".vipdj").html('银卡级及以上')
                        } else if ($(".vipdj").html() == '2') {
                            $(".vipdj").html('金卡级及以上')
                        } else if ($(".vipdj").html() == '3') {
                            $(".vipdj").html('白金级及以上')
                        } else if ($(".vipdj").html() == '9') {
                            $(".vipdj").html('钻石级')
                        }

                        if ($(".fxdj").html() == '1') {
                            $(".fxdj").html('一级（低）')
                        } else if ($(".fxdj").html() == '2') {
                            $(".fxdj").html('二级（中低）')
                        } else if ($(".fxdj").html() == '3') {
                            $(".fxdj").html('三级（中）')
                        } else if ($(".fxdj").html() == '4') {
                            $(".fxdj").html('四级（中高）')
                        } else if ($(".fxdj").html() == '5') {
                            $(".fxdj").html('五级（高）')
                        }
                        if ($(".cpzt_product").html().trim() == '0') {
                            $(".cpzt").html('募集')
                        } else if ($(".cpzt_product").html().trim() == '1') {
                            $(".cpzt").html('存续')
                        } else if ($(".cpzt_product").html().trim() == '5') {
                            $(".cpzt").html('已到期')
                        } else if ($(".cpzt_buy").html().trim() == '1' || $(".cpzt_buy").html().trim() == '4' || $(".cpzt_buy").html().trim() == '1,4') {
                            $(".cpzt").html('在售')
                        } else if ($(".cpzt_buy").html().trim() == '3') {
                            $(".cpzt").html('预约')
                        }

                    })
        </script>
        
        
