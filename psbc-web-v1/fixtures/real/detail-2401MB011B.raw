        <script>
            $(function(){

                for( var l = 0 ; l < $(".tableCplx1").length; l ++){
                    if($(".tableCplx1").eq(l).html().trim() == '1'){
                        console.log('货币型')
                        $(".tableHbx").eq(l).show();
                    }else{
                        if($(".tableCplx2").eq(l).html().trim() == '02' || $(".tableCplx2").eq(l).html().trim() == '04'){
                            console.log('预期型')
                            $(".tableYqx").eq(l).show();
                        }
                        if($(".tableCplx2").eq(l).html().trim() == '01' || $(".tableCplx2").eq(l).html().trim() == '03'){
                        console.log('净值型')
                        $(".tableJzx").eq(l).show();
                        }
                    }

//20210624
                    /*if($(".typeZylc").eq(l).html().trim().substring(8,9) == '1'){
                        $(".typeZylc").eq(l).html('中邮理财')
                    }else{
                        $(".typeZylc").eq(l).hide()
                    }*/
                }

                for( var x = 0 ; x < (".functionX100").length; x++){
                  $(".functionX100").eq(x).html(Number(($(".functionX100").eq(x).html())*100).toFixed(2)+'%');
                }
				
				//显示业绩比较基准提示
				$('.info').each(function(){
					
					var prd=$(this).attr('CURTYPEPRODUCT');/*收益类型*/
					var thr=$(this).attr('NET_EXPECT_PRODUCT');/*是否货币类型*/
					if((prd=='1')&&($(this).attr('SEVEN_ANNUAL_YIELD')=='')){
						$(this).show();
					}else if(((thr=='01')||(thr=='03'))&&$(this).attr('LATEST_NET')==''){
						$(this).show();
					}
				});
                
            })
        </script>
         
